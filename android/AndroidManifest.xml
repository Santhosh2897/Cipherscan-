<?xml version="1.0" encoding="utf-8"?>
<!--
  CipherScan — AndroidManifest.xml (stub reference)
  The canonical manifest is android/app/src/main/AndroidManifest.xml.
  This stub is kept for reference only.

  WHY autoVerify IS OMITTED on http/https filters:
  android:autoVerify="true" requires a specific android:host attribute paired
  with a hosted /.well-known/assetlinks.json on that exact domain.
  A wildcard filter (scheme only, no host) will silently fail verification
  and behave WORSE than omitting autoVerify. For generic link interception
  the chooser dialog is the correct UX. Restore autoVerify only if a
  companion domain is registered with a matching assetlinks.json file.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cipherscan.android">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CipherScan">

        <!-- ============================================================
             LinkInterceptorActivity
             Transparent activity triggered by the OS for every web link
             and UPI payment intent. Performs background threat analysis,
             then routes to the target app or shows the security overlay.
             ============================================================ -->
        <activity
            android:name=".LinkInterceptorActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Translucent"
            android:taskAffinity=""
            android:excludeFromRecents="true">

            <!-- HTTP + HTTPS web link interception (no autoVerify — see file header) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!-- UPI deep link interception (payment intents) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="upi" android:host="pay" />
            </intent-filter>

        </activity>

        <!-- Main app entry (dashboard) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
