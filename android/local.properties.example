# CipherScan — local.properties.example
# Copy this file to local.properties and fill in your values.
# local.properties is gitignored — never commit real secrets.

# Point at your deployed CipherScan backend (include trailing slash):
cipherscan.server.url=https://your-backend.replit.app/

# Android SDK path (set automatically by Android Studio):
# sdk.dir=/Users/yourname/Library/Android/sdk
