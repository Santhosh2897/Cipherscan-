<?xml version="1.0" encoding="utf-8"?>
<!--
  CipherScan — activity_link_interceptor.xml
  Transparent fullscreen overlay shown while the URL is being analyzed.
  Hosts a centered loading indicator + status text.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Semi-transparent scrim so the user knows something is happening -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0A0E1A" />

    <!-- Center card -->
    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/card_bg_rounded"
        android:padding="24dp">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/accent_cyan"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verifying link safety…"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:gravity="center" />

    </LinearLayout>

</FrameLayout>
