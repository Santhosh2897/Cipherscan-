<?xml version="1.0" encoding="utf-8"?>
<!--
  CipherScan — activity_link_interceptor.xml
  Transparent fullscreen overlay shown while the URL is being analyzed.
  Displays loading spinner during analysis, then instant green verified badge
  before auto-proceeding to safe websites.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Semi-transparent scrim so the user knows something is happening -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0A0E1A" />

    <!-- Center card -->
    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/card_bg_rounded"
        android:padding="24dp">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminateTint="@color/accent_cyan"
            android:layout_marginBottom="14dp" />

        <ImageView
            android:id="@+id/ivVerifiedBadge"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_verified_safe"
            android:visibility="gone"
            android:layout_marginBottom="14dp"
            android:contentDescription="Verified Safe" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verifying link safety…"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvSubStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Proceeding to website…"
            android:textColor="@color/safe_green"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:gravity="center" />

    </LinearLayout>

</FrameLayout>
