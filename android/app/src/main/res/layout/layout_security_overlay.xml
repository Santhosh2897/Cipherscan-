<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1E2E"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Verdict Header & Risk Score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvVerdictBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#33EF4444"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="MALICIOUS"
                android:textColor="#EF4444"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvRiskScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Risk Score: 0/100"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Target URL -->
        <TextView
            android:id="@+id/tvTargetUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="https://example.com"
            android:textColor="#9CA3AF"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#374151" />

        <!-- Threat Reasons Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Threat Details"
            android:textColor="#F3F4F6"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/containerThreatReasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- Screenshot Preview -->
        <ImageView
            android:id="@+id/ivScreenshotPreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:background="#111827"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#EF4444"
                android:text="Block / Exit"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnProceedAnyway"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#374151"
                android:text="Proceed"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Direct Web Dashboard Link -->
        <Button
            android:id="@+id/btnViewOnWebDashboard"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Open in Web Dashboard ↗"
            android:textColor="#38BDF8"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>