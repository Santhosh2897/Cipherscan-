<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cipherscan.android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Required on Android 11+ (API 30+) to query and launch external browsers -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CipherScan">

        <!-- ============================================================
             LinkInterceptorActivity
             Transparent activity triggered by the OS for every web link
             and UPI payment intent. Performs background threat analysis,
             then routes to the target app or shows the security overlay.

             WHY autoVerify IS OMITTED on http/https filters:
             android:autoVerify="true" requires a specific android:host
             attribute paired with a hosted /.well-known/assetlinks.json
             file on that exact domain. A wildcard filter with only
             android:scheme="http" (no host) has undefined verification
             behaviour — Android will attempt to verify every domain
             encountered, fail, and silently downgrade the handler to a
             chooser dialog, which is WORSE than omitting autoVerify.

             For generic link interception the chooser dialog IS the
             correct UX. If a companion domain (e.g. cipherscan.app) is
             registered in future, add android:host="cipherscan.app" and
             restore autoVerify="true" with a matching assetlinks.json.
             ============================================================ -->
        <activity
            android:name=".activity.LinkInterceptorActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Translucent"
            android:taskAffinity=""
            android:excludeFromRecents="true">

            <!--
                HTTP + HTTPS web link interception.
                No autoVerify — see comment above.
                Both schemes share a single intent-filter for clarity.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!-- UPI deep link interception (payment intents). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="upi" android:host="pay" />
            </intent-filter>
        </activity>

        <!-- Main Dashboard Activity -->
        <activity
            android:name=".activity.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>