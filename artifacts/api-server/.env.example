# Port the server listens on
PORT=8080

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cipherscan

# Shared secret required on every API request (x-api-key header).
# Generate with: openssl rand -hex 32
APP_API_KEY=

# Web dashboard origin allowed to make cross-origin requests.
# Leave unset to block all browser-based cross-origin requests.
ALLOWED_ORIGIN=http://localhost:5173

# Optional — reputation checks are skipped (score 0) if not set
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional — used to build previewImageUrl; defaults to request host if unset
SERVER_BASE_URL=
