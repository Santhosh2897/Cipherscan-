# Backend base URL (no trailing slash) — LOCAL DEVELOPMENT ONLY.
# In production (Vercel), the BFF proxy adds the API key server-side.
VITE_API_BASE_URL=http://localhost:8080

# Local dev only: set to the same value as APP_API_KEY in api-server/.env
# so direct Express calls in dev work. Leave empty in Vercel env vars.
# In production the BFF (api/proxy.ts) reads APP_API_KEY server-side instead.
VITE_DEV_API_KEY=
