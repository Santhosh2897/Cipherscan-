# ==============================================================================
# LOCAL DEVELOPMENT (Vite Client)
# ==============================================================================
# Backend base URL (no trailing slash) — LOCAL DEVELOPMENT ONLY.
# In production (Vercel), all requests go to /api and are handled by the BFF proxy.
VITE_API_BASE_URL=http://localhost:8080

# Local dev only: set to the same value as APP_API_KEY in api-server/.env
# so direct Express calls in dev work without the BFF proxy. Leave empty in Vercel.
VITE_DEV_API_KEY=

# ==============================================================================
# VERCEL SERVERLESS / BFF PROXY (Production Environment Variables)
# ==============================================================================
# Set these in your Vercel Dashboard -> Project Settings -> Environment Variables

# The public live URL of your backend (e.g. Render)
BACKEND_URL=https://cipherscan-ecjs.onrender.com

# Shared API key required by the backend (must match APP_API_KEY on Render)
APP_API_KEY=1d409806dab4a17909e843c8933b78ea5323773141eb04c30bfa0c5b3885ff20

# Optional: PIN required to unlock Dashboard and issue session tokens (e.g. 1234)
DASHBOARD_PIN=

# Optional: Admin PIN required to unlock full fleet telemetry and admin view
ADMIN_PIN=
