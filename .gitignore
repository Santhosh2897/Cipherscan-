# Dependencies
node_modules/
.pnpm-store/

# Build outputs & caches
dist/
build/
*.tsbuildinfo
.clinic/
coverage/

# Android binaries & build artifacts (Releases are hosted on GitHub Releases)
*.apk
*.aab
android/.gradle/
android/local.properties
android/*.iml
android/.idea/
android/captures/
android/app/build/
android/build/

# Secrets — NEVER commit real values in any .env file.
# If these accidentally get committed, rotate ALL secrets immediately:
#   VIRUSTOTAL_API_KEY           → https://www.virustotal.com/gui/my-apikey
#   GOOGLE_SAFE_BROWSING_API_KEY → https://console.cloud.google.com/apis/credentials
#   APP_API_KEY                  → openssl rand -hex 32, then update Render + android/local.properties
#   DATABASE_URL                 → rotate in Neon / Postgres provider
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# Screenshot previews generated by sandboxService (runtime artefacts)
public/previews/
artifacts/public/previews/
**/previews/

# OS/editor cruft & logs
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Database & local dumps / temp artifacts
*.dump
*.sql.gz
*.sqlite
*.sqlite-journal