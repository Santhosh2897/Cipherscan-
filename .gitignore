# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# ─────────────────────────────────────────────────────────────────────────────
# Secrets — NEVER commit real values in any .env file.
# If these accidentally get committed, rotate ALL secrets immediately:
#   VIRUSTOTAL_API_KEY   → https://www.virustotal.com/gui/my-apikey
#   GOOGLE_SAFE_BROWSING_API_KEY → https://console.cloud.google.com/apis/credentials
#   APP_API_KEY          → openssl rand -hex 32, then update Render + android/local.properties
#   DATABASE_URL         → rotate in Neon / Postgres provider
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
# Catch-all — also excludes nested .env files in artifacts/ subdirectories
**/.env
**/.env.local
**/.env.*.local
android/local.properties

# Android
android/.gradle/
android/local.properties
android/*.iml
android/.idea/
android/captures/
android/app/build/
android/build/

# Screenshot previews generated by sandboxService (runtime artefacts)
public/previews/

# OS/editor cruft
.DS_Store
*.log